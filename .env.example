APP_NAME=NexMatch AI
APP_ENV=development
APP_VERSION=1.0.0

# Secret key for token generation
SECRET_KEY=nexmatch_super_secret_session_key_12345

# Admin Credentials Setup
ADMIN_NAME=admin
ADMIN_EMAIL=admin@nexmatch.ai
ADMIN_PASSWORD=AdminSecurePassword2026!

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Features
ENABLE_EMAILS=false
ENABLE_SIGNUPS=true
ENABLE_PASSWORD_RESET=true

# Expirations & Limits
PASSWORD_RESET_EXPIRY_MINUTES=30
FEEDBACK_RETRAIN_THRESHOLD=50

# Paths
MODEL_PATH=models
DATA_PATH=data
